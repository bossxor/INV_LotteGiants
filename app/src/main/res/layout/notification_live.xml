<?xml version="1.0" encoding="utf-8"?>
<!-- 빅이닝식: 로고-점수-다이아-점수-로고 / 투수·BSO·타자 / 승률 바. 시스템 알림 배경 유지. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_away_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원정"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/notif_away_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_away_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/NotifScore"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_away_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="28dp"
            android:textAppearance="@style/NotifScore"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minWidth="64dp"
            android:orientation="vertical"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/notif_bases"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_inning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/notif_inning_pill"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_venue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_home_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="28dp"
            android:textAppearance="@style/NotifScore"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_home_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/notif_home_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_home_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/NotifScore"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_bso_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_pitcher_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:textAppearance="@style/NotifLine"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/notif_bso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B"
                android:textColor="#2EA35C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_b0"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="S"
                android:textColor="#C9A227"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_s0"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_s1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_s2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="O"
                android:textColor="#C8102E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_o0"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_o1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_o2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_batter_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:textAppearance="@style/NotifLine"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_winprob_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_winprob_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_winprob_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_winprob_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
