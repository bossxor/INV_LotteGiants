<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/notif_live_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="B"
                android:textColor="#2EA35C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_b0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="#C9A227"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_s0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_s1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_s2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:text="O"
                android:textColor="#C8102E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_o0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_o1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_o2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_inning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFAAB4CB"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/notif_count_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notif_players_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFAAB4CB"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_bases"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
