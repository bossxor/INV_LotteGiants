<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/notif_live_bg"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- 팀 로고 · 점수 · 루상 · 이닝 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/notif_away_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_away_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFAAB4CB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/notif_bases"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notif_away_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notif_inning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/notif_inning_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notif_home_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/notif_home_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_home_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFAAB4CB"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 투수 · BSO · 타자 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_pitcher_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFD0D6E2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B"
                android:textColor="#2EA35C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_b0"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_b1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <ImageView
                android:id="@+id/notif_b2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <ImageView
                android:id="@+id/notif_b3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="S"
                android:textColor="#C9A227"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_s0"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_s1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <ImageView
                android:id="@+id/notif_s2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="O"
                android:textColor="#C8102E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_o0"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="2dp" />

            <ImageView
                android:id="@+id/notif_o1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />

            <ImageView
                android:id="@+id/notif_o2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_batter_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#FFD0D6E2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 좌(원정) · 우(홈) 실시간 승률 바 -->
    <ImageView
        android:id="@+id/notif_winprob_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</LinearLayout>
