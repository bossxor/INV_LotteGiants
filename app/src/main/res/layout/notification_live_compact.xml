<?xml version="1.0" encoding="utf-8"?>
<!--
  접힌 알림은 높이가 64dp 정도로 잘린다. 큰 카드를 그대로 넣으면 중간이 썰려 보여서
  한 줄로만 쓰는 전용 레이아웃을 둔다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/notif_live_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/notif_c_away_logo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/notif_c_away_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:minWidth="26dp"
        android:textColor="#FFFFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_c_inning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/notif_inning_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_c_home_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:minWidth="26dp"
        android:textColor="#FFFFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/notif_c_home_logo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/notif_c_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#FFAAB4CB"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/notif_c_bases"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
</LinearLayout>
