<?xml version="1.0" encoding="utf-8"?>
<!--
  Now Bar 카드.
  맨 위 줄 = 알약에 잘려 보이는 로고 점수:점수 로고(왼쪽) + 이닝/시간 알약(오른쪽, 카드에서만 보임)
  팀명·순위 / 투수 · 루상 다이아몬드 · 타자 / B·S·O / 이닝별 점수표(중·후) · 승률(전)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="0dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 알약은 이 줄의 왼쪽만 자른다. 짧게 두어야 오른쪽 로고까지 들어간다. -->
        <LinearLayout
            android:id="@+id/notif_pill_row"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="start"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notif_pill_away_logo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_pill_away_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text=":"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_pill_home_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notif_pill_home_logo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="9dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <!-- 오른쪽 로고가 잘리지 않게 폭만 살짝 확보 (투명) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u2007\u2007"
                android:textColor="#00000000"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/notif_inning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_inning_pill"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 팀명 + 순위 (원정 왼쪽 · 홈 오른쪽). 가운데는 구장 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_away_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifScore"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_away_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textAppearance="@style/NotifMeta"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_venue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/NotifMeta"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_home_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifScore"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_home_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textAppearance="@style/NotifMeta"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 투수 | 루상 다이아몬드 | 타자 -->
    <LinearLayout
        android:id="@+id/notif_bso_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp">

        <TextView
            android:id="@+id/notif_pitcher_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/NotifLine"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_bases"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/notif_batter_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:textAppearance="@style/NotifLine"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 볼 3 · 스트라이크 2 · 아웃 2 -->
    <LinearLayout
        android:id="@+id/notif_bso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="#2EA35C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_b0"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp" />

        <ImageView
            android:id="@+id/notif_b1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp" />

        <ImageView
            android:id="@+id/notif_b2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="S"
            android:textColor="#C9A227"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_s0"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp" />

        <ImageView
            android:id="@+id/notif_s1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="O"
            android:textColor="#C8102E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_o0"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp" />

        <ImageView
            android:id="@+id/notif_o1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_winprob_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_winprob_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_winprob_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_winprob_bar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- 경기 전: 일시·구장 / 경기 후: 다음 경기 -->
    <TextView
        android:id="@+id/notif_info_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/NotifLine"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_scoreboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:minHeight="150dp"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- 코드가 값을 넣는 옛 id (이 카드에서는 안 쓰므로 숨김) -->
    <ImageView
        android:id="@+id/notif_away_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_home_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notif_away_score"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notif_home_score"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_b3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_s2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_o2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
