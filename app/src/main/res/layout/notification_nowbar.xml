<?xml version="1.0" encoding="utf-8"?>
<!-- Now Bar 카드: 윗줄(로고·점수·이닝)만 잠금화면 알약에 보이고, 나머지는 카드에서만 보인다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_away_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/notif_away_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="@drawable/notif_score_chip"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_inning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_inning_pill"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_home_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notif_score_chip"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_home_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_away_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="원정"
            android:textAppearance="@style/NotifMeta"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/notif_away_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/NotifScore"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_venue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/NotifMeta"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/notif_home_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/NotifScore"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_home_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="홈"
            android:textAppearance="@style/NotifMeta"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_bso_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_pitcher_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingEnd="4dp"
            android:textAppearance="@style/NotifLine"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/notif_bases"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/notif_bso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#2EA35C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/notif_b0"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="3dp" />

                <ImageView
                    android:id="@+id/notif_b1"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/notif_b2"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/notif_b3"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="#C9A227"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/notif_s0"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="3dp" />

                <ImageView
                    android:id="@+id/notif_s1"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/notif_s2"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="O"
                    android:textColor="#C8102E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/notif_o0"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="3dp" />

                <ImageView
                    android:id="@+id/notif_o1"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/notif_o2"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notif_batter_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:textAppearance="@style/NotifLine"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_winprob_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_winprob_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_winprob_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/NotifMeta"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_winprob_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_info_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/NotifLine"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/notif_scoreboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</LinearLayout>
